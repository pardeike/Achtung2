<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>$(ModFileName)</RootNamespace>
		<AssemblyName>$(ModFileName)</AssemblyName>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<OutputPath>..\1.7\Assemblies\</OutputPath>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<NoWarn>$(NoWarn);NU1701</NoWarn>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Version>$(ModVersion)</Version>
		<AssemblyVersion>$(ModVersion)</AssemblyVersion>
		<FileVersion>$(ModVersion)</FileVersion>
		<PackageVersion>$(ModVersion)</PackageVersion>
		<InformationalVersion>$(ModVersion)</InformationalVersion>
		<Company>Brrainz</Company>
		<Authors>Andreas Pardeike</Authors>
		<Copyright>Copyright Andreas Pardeike</Copyright>
		<PackageProjectUrl>$(Repository)</PackageProjectUrl>
		<RepositoryUrl>$(Repository)</RepositoryUrl>
		<Product>$(ModName)</Product>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugSymbols>false</DebugSymbols>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DefineConstants>RW12;RW13;TRACE;DEBUG</DefineConstants>
		<Optimize>false</Optimize>
		<DebugType>embedded</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="*.cs" />
		<None Include="BridgeTools\**\*" />
		<Content Include="..\Directory.Build.props">
			<Link>%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Brrainz.RimWorld.CrossPromotion" Version="1.1.2" />
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4990-unstable" GeneratePathProperty="true" />
		<PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.4" />
		<PackageReference Include="RimWorld.MultiplayerAPI" Version="0.6.0" />
		<PackageReference Include="TaskPubliciser" Version="1.0.3" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="ModFeatures">
			<HintPath>..\1.7\Assemblies\ModFeatures.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<Target Name="PubliciseGame" BeforeTargets="ResolveAssemblyReferences">
		<PropertyGroup>
			<PublicisedDir>$(MSBuildProjectDirectory)\obj\publicised\</PublicisedDir>
		</PropertyGroup>
		<MakeDir Directories="$(PublicisedDir)" />
		<Publicise TargetAssemblyPath="$(PkgKrafs_Rimworld_Ref)\ref\net10.0\Assembly-CSharp.dll" OutputPath="$(PublicisedDir)" />
		<ItemGroup>
			<Reference Include="$(PublicisedDir)Assembly-CSharp_publicised.dll"><Private>false</Private></Reference>
		</ItemGroup>
	</Target>

	<Target Name="ReplaceGameReference" AfterTargets="ResolveLockFileReferences">
		<ItemGroup>
			<Reference Remove="$(PkgKrafs_Rimworld_Ref)\ref\net10.0\Assembly-CSharp.dll" />
		</ItemGroup>
	</Target>

	<Target Name="PostBuildAction" AfterTargets="Build">
		<Delete Files="..\1.7\Assemblies\RimBridgeServer.Annotations.dll;..\1.7\Assemblies\RimBridgeServer.Sdk.dll" />
		<XmlPoke XmlInputPath="$(MSBuildProjectDirectory)\..\About\About.xml" Query="//ModMetaData/modVersion" Value="$(ModVersion)" />
		<XmlPoke XmlInputPath="$(MSBuildProjectDirectory)\..\About\Manifest.xml" Query="//Manifest/version" Value="$(ModVersion)" />
	</Target>

	<Target Name="RestoreBridgeTools" BeforeTargets="Build" Condition="'$(BuildBridgeTools)' != 'false'">
		<Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; restore &quot;$(MSBuildProjectDirectory)\BridgeTools\Achtung.BridgeTools.csproj&quot; --nologo --verbosity quiet" />
	</Target>

	<Target Name="BuildBridgeTools" DependsOnTargets="RestoreBridgeTools" AfterTargets="Build" Condition="'$(BuildBridgeTools)' != 'false'">
		<MSBuild
			Projects="$(MSBuildProjectDirectory)\BridgeTools\Achtung.BridgeTools.csproj"
			Targets="Build"
			Properties="Configuration=$(Configuration);Platform=$(Platform);AchtungAssemblyPath=$(TargetPath)" />
	</Target>

	<Target Name="ValidateRimworldDeployRoot" BeforeTargets="Build;CopyToRimworld" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' != 'true'">
		<PropertyGroup>
			<DeployGuardScript>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\scripts\rimworld-deploy-guard.sh'))</DeployGuardScript>
		</PropertyGroup>
		<Exec Command="&quot;$(DeployGuardScript)&quot; validate &quot;$(RIMWORLD_MOD_DIR)&quot; &quot;$(MSBuildProjectFullPath)&quot; &quot;$(ModFileName)&quot;" />
	</Target>

	<Target Name="CopyToRimworld" DependsOnTargets="BuildBridgeTools" AfterTargets="PostBuildAction" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' != 'true'">
		<PropertyGroup>
			<DeployGuardScript>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\scripts\rimworld-deploy-guard.sh'))</DeployGuardScript>
		</PropertyGroup>
		<Exec Command="&quot;$(DeployGuardScript)&quot; deploy &quot;$(RIMWORLD_MOD_DIR)&quot; &quot;$(MSBuildProjectFullPath)&quot; &quot;$(Configuration)&quot; &quot;$(Platform)&quot; &quot;$(ModFileName)&quot; &quot;$(BuildBridgeTools)&quot;" />
	</Target>

	<Target Name="_CopyToRimworldUnlocked" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' == 'true'">
		<Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../scripts/verify-frozen-payload.py&quot; &quot;$(RIMWORLD_MOD_DIR)/$(ModFileName)&quot;" />
		<RemoveDir Directories="$(RIMWORLD_MOD_DIR)\$(ModFileName)\1.7" />
		<PropertyGroup>
			<!-- Keep the companion DLL paired with the deployed mod DLL: Mods/Achtung and sibling Mods/../BridgeTools/Achtung are one deployment unit. -->
			<GlobalBridgeToolsDir>$(RIMWORLD_MOD_DIR)\..\BridgeTools</GlobalBridgeToolsDir>
		</PropertyGroup>
		<ItemGroup>
			<Copy_11 Include="..\1.1\**" Exclude="..\1.1\**\.DS_Store;..\1.1\**\._*" Condition="!Exists('$(RIMWORLD_MOD_DIR)/$(ModFileName)/1.1')" />
			<Copy_12 Include="..\1.2\**" Exclude="..\1.2\**\.DS_Store;..\1.2\**\._*" Condition="!Exists('$(RIMWORLD_MOD_DIR)/$(ModFileName)/1.2')" />
			<Copy_13 Include="..\1.3\**" Exclude="..\1.3\**\.DS_Store;..\1.3\**\._*" Condition="!Exists('$(RIMWORLD_MOD_DIR)/$(ModFileName)/1.3')" />
			<Copy_14 Include="..\1.4\**" Exclude="..\1.4\**\.DS_Store;..\1.4\**\._*" Condition="!Exists('$(RIMWORLD_MOD_DIR)/$(ModFileName)/1.4')" />
			<Copy_15 Include="..\1.5\**" Exclude="..\1.5\**\.DS_Store;..\1.5\**\._*" Condition="!Exists('$(RIMWORLD_MOD_DIR)/$(ModFileName)/1.5')" />
			<Copy_16 Include="..\1.6\**" Exclude="..\1.6\BridgeTools\**;..\1.6\**\.DS_Store;..\1.6\**\._*" Condition="!Exists('$(RIMWORLD_MOD_DIR)/$(ModFileName)/1.6')" />
			<Copy_17 Include="..\1.7\**" Exclude="..\1.7\**\.DS_Store;..\1.7\**\._*;..\1.7\**\*.pdb" />
			<CopyAbout Include="..\About\**" Exclude="..\About\**\.DS_Store;..\About\**\._*" />
			<CopyFeatures Include="..\Features\**" Exclude="..\Features\**\.DS_Store;..\Features\**\._*" Condition="!Exists('$(RIMWORLD_MOD_DIR)/$(ModFileName)/Features')" />
			<CopyLanguages Include="..\Languages\**" Exclude="..\Languages\**\.DS_Store;..\Languages\**\._*" Condition="!Exists('$(RIMWORLD_MOD_DIR)/$(ModFileName)/Languages')" />
			<CopyPatches Include="..\Patches\**" Exclude="..\Patches\**\.DS_Store;..\Patches\**\._*" Condition="!Exists('$(RIMWORLD_MOD_DIR)/$(ModFileName)/Patches')" />
			<CopyTextures Include="..\Textures\**" Exclude="..\Textures\**\.DS_Store;..\Textures\**\._*" Condition="!Exists('$(RIMWORLD_MOD_DIR)/$(ModFileName)/Textures')" />
			<CopyLicense Include="..\LICENSE" />
			<CopyLoadFolders Include="..\LoadFolders.xml" />
			<CopyReadme Include="..\README.md" />
			<CopyBridgeTools Include="..\artifacts\BridgeTools\Achtung\Achtung.BridgeTools.dll" Condition="'$(BuildBridgeTools)' != 'false'" />
		</ItemGroup>
		<Copy SourceFiles="@(Copy_11)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\1.1\%(RecursiveDir)" />
		<Copy SourceFiles="@(Copy_12)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\1.2\%(RecursiveDir)" />
		<Copy SourceFiles="@(Copy_13)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\1.3\%(RecursiveDir)" />
		<Copy SourceFiles="@(Copy_14)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\1.4\%(RecursiveDir)" />
		<Copy SourceFiles="@(Copy_15)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\1.5\%(RecursiveDir)" />
		<Copy SourceFiles="@(Copy_16)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\1.6\%(RecursiveDir)" />
		<Copy SourceFiles="@(Copy_17)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\1.7\%(RecursiveDir)" />
		<Copy SourceFiles="@(CopyAbout)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\About\%(RecursiveDir)" />
		<Copy SourceFiles="@(CopyFeatures)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\Features\%(RecursiveDir)" />
		<Copy SourceFiles="@(CopyLanguages)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\Languages\%(RecursiveDir)" />
		<Copy SourceFiles="@(CopyPatches)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\Patches\%(RecursiveDir)" />
		<Copy SourceFiles="@(CopyTextures)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\Textures\%(RecursiveDir)" />
		<Copy SourceFiles="@(CopyLicense)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)" />
		<Copy SourceFiles="@(CopyLoadFolders)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)" />
		<Copy SourceFiles="@(CopyReadme)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)" />
		<Copy SourceFiles="@(CopyBridgeTools)" DestinationFolder="$(GlobalBridgeToolsDir)\Achtung" SkipUnchangedFiles="true" Condition="'@(CopyBridgeTools)' != ''" />
	</Target>

	<Target Name="_ZipModUnlocked" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' == 'true'">
		<ZipDirectory SourceDirectory="$(RIMWORLD_MOD_DIR)\$(ModFileName)" DestinationFile="$(RIMWORLD_MOD_DIR)\$(ModFileName).zip" Overwrite="true" />
	</Target>

	<Target Name="ZipMod" DependsOnTargets="CopyToRimworld" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' != 'true'" />

</Project>
